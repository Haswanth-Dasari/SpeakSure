OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=20
LLM_ANALYSIS_MODEL=openai/gpt-oss-120b
LLM_ANALYSIS_REASONING_EFFORT=medium
SPEECH_TO_TEXT_PROVIDER=local
# The code default remains "base"; "medium" is recommended for a 6 GB GPU.
SPEECH_TO_TEXT_MODEL_SIZE=medium
SPEECH_TO_TEXT_DEVICE=auto
SPEECH_TO_TEXT_LANGUAGE=en
SPEECH_TO_TEXT_VAD_FILTER=true
SPEECH_TO_TEXT_HOTWORDS=
# Local faster-whisper only; ignored by the OpenAI transcription provider.
SPEECH_TO_TEXT_INITIAL_PROMPT=
TEXT_TO_SPEECH_VOICE=en_US-lessac-medium
TEXT_TO_SPEECH_MODELS_DIR=models/piper
TEXT_TO_SPEECH_LENGTH_SCALE=1.0
TEXT_TO_SPEECH_LEADING_SILENCE_SECONDS=0.15
TEXT_TO_SPEECH_TRAILING_SILENCE_SECONDS=0.5
# Second, slower transcription pass used only for the report (accuracy over speed).
# Use "off" to disable. It must differ from SPEECH_TO_TEXT_MODEL_SIZE to take effect.
REPORT_SPEECH_TO_TEXT_MODEL=large-v3
# Rate each answer several times and report the median (reduces score noise).
CONTENT_RATING_SAMPLES=3
# Show the rule-based grammar section in the report (off by default: mostly false alarms on speech).
SHOW_RULE_GRAMMAR=0
